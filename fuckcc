cmd_install_global() {
  ensure_home
  cmd_build_hook 2>/dev/null || true
  write_shim
  cmd_install_hooks
  cfg_set DEEP 1
  cfg_set USE_HOOK 1
  cfg_set PROMPT_TRANSLATE 1
  cfg_set DISABLE_TELEMETRY 1

  local path_line='export PATH="$HOME/.fuckcc/shim:$PATH"  # fuckcc-auto'
  local f
  for f in "$HOME/.zshenv" "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.bash_profile" "$HOME/.bashrc"; do
    if [[ -f "$f" ]] && grep -qE 'fuckcc-auto|fuckcc/shim' "$f" 2>/dev/null; then
      if grep -q 'fuckcc' "$f"; then
        sed -i '' '/fuckcc\/shim/d' "$f" 2>/dev/null || true
        sed -i '' '/fuckcc-auto/d' "$f" 2>/dev/null || true
      fi
    fi
    touch "$f"
    if ! grep -qF 'fuckcc/shim' "$f" 2>/dev/null; then
      local tmp
      tmp=$(mktemp)
      printf '%s\n\n' "$path_line" >"$tmp"
      cat "$f" >>"$tmp"
      mv "$tmp" "$f"
      ok "PATH 置顶: $f"
    fi
  done

  mkdir -p "$HOME/.local/bin"
  if [[ -e "$HOME/.local/bin/claude" ]] && ! grep -q "$SHIM_MARKER" "$HOME/.local/bin/claude" 2>/dev/null; then
    if [[ ! -e "$HOME/.local/bin/claude.pre-fuckcc" ]]; then
      cp -p "$HOME/.local/bin/claude" "$HOME/.local/bin/claude.pre-fuckcc" 2>/dev/null || true
    fi
  fi
  local self
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  cat >"$HOME/.local/bin/claude" <<EOF
$SHIM_MARKER
set -euo pipefail
export FUCKCC_HOME="${FUCKCC_HOME}"
export PATH="$FUCKCC_HOME/shim:\$PATH"
exec $(printf %q "$self") run -- "\$@"
EOF
  chmod +x "$HOME/.local/bin/claude"
  ok "已覆盖 ~/.local/bin/claude -> fuckcc"

  if [[ -d "$HOME/.npm-global/bin" ]]; then
    if [[ -e "$HOME/.npm-global/bin/claude" ]] && ! grep -q "$SHIM_MARKER" "$HOME/.npm-global/bin/claude" 2>/dev/null; then
      [[ -e "$HOME/.npm-global/bin/claude.pre-fuckcc" ]] || cp -p "$HOME/.npm-global/bin/claude" "$HOME/.npm-global/bin/claude.pre-fuckcc" 2>/dev/null || true
      if [[ -x "$HOME/.npm-global/bin/claude.pre-fuckcc" ]]; then
        echo "$HOME/.npm-global/bin/claude.pre-fuckcc" >"$REAL_BIN_FILE"
        cfg_set REAL_CLAUDE "$HOME/.npm-global/bin/claude.pre-fuckcc"
      fi
    fi
    cat >"$HOME/.npm-global/bin/claude" <<EOF
$SHIM_MARKER
set -euo pipefail
export FUCKCC_HOME="${FUCKCC_HOME}"
exec $(printf %q "$self") run -- "\$@"
EOF
    chmod +x "$HOME/.npm-global/bin/claude"
    ok "已覆盖 ~/.npm-global/bin/claude -> fuckcc"
  fi

  if [[ "$(cfg_get USE_PROXY 0)" == "1" ]]; then
    cmd_proxy_start || warn "proxy 先起失败，下次 claude 会再试"
  else
    info "USE_PROXY=0：不劫持 ANTHROPIC_BASE_URL，交给 CC Switch / 官方账号路由"
  fi
  cmd_translate_daemon_start || true
  ok "安装完成。新开终端后: claude / claude --dangerously-skip-permissions 全部自动伪装"
  info "切地区: fuckcc use us-west | jp | uk ..."
  info "翻译开关: ~/.fuckcc/config 里 PROMPT_TRANSLATE=1"
  info "中转域名反代(可选，会跟 CC Switch 账号路由冲突): fuckcc proxy-start"
}



cmd_translate_daemon_start() {
  ensure_home
  if [[ -f "$FUCKCC_HOME/translate_daemon.state.json" ]]; then
    local pid
    pid=$(python3 -c "import json;print(json.load(open('$FUCKCC_HOME/translate_daemon.state.json')).get('pid',''))" 2>/dev/null || true)
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      ok "translate-daemon already pid=$pid"
      return 0
    fi
  fi
  nohup python3 "$SCRIPT_DIR/lib/translate_daemon.py" >>"$FUCKCC_HOME/translate_daemon.log" 2>&1 &
  sleep 1.5
  if curl -fsS "http://127.0.0.1:$(cfg_get FUCKCC_TRANSLATE_PORT 19284)/health" >/dev/null 2>&1; then
    ok "translate-daemon up"
  else
    warn "translate-daemon starting slow, see $FUCKCC_HOME/translate_daemon.log"
  fi
}
cmd_translate_daemon_stop() {
  if [[ -f "$FUCKCC_HOME/translate_daemon.state.json" ]]; then
    local pid
    pid=$(python3 -c "import json;print(json.load(open('$FUCKCC_HOME/translate_daemon.state.json')).get('pid',''))" 2>/dev/null || true)
    [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
    rm -f "$FUCKCC_HOME/translate_daemon.state.json"
    ok "translate-daemon stopped"
  fi
}


cmd_ui() {
  local app="$FUCKCC_HOME/FuckCC.app"
  local builder="$SCRIPT_DIR/ui/build_app.sh"
  if [[ ! -d "$app" || ! -x "$app/Contents/MacOS/FuckCC" ]]; then
    [[ -x "$builder" ]] || die "缺少 ui/build_app.sh"
    info "编译控制台 UI..."
    "$builder" "$FUCKCC_HOME"
  fi
  open "$app"
  ok "已打开 FuckCC.app（桌面也有副本）"
}


cmd_set_mode() {
  local m="${1:-}"
  [[ -n "$m" ]] || die "fuckcc mode <manual|acceptEdits|auto|plan|dontAsk|bypass|safe|allow-bypass>"
  case "$m" in
    manual|acceptEdits|accept|edit|auto|plan|dontAsk|dontask|noask|bypass|bypassPermissions|yolo|danger|safe|allow-bypass) ;;
    *) die "未知模式: $m" ;;
  esac
  case "$m" in
    accept|edit) m=acceptEdits ;;
    dontask|noask) m=dontAsk ;;
    bypassPermissions|yolo|danger) m=bypass ;;
  esac
  cfg_set LAUNCH_MODE "$m"
  ok "LAUNCH_MODE=$m"
  info "下次 claude / fuckcc run 生效。对应参数: $(claude_launch_args)"
}
cmd_show_mode() {
  local m
  m=$(cfg_get LAUNCH_MODE bypass)
  echo "LAUNCH_MODE=$m"
  echo "args: $(claude_launch_args)"
}


cmd_set_translate() {
  local v="${1:-}"
  case "$v" in
    on|1|true|yes) cfg_set PROMPT_TRANSLATE 1; ok "PROMPT_TRANSLATE=1 (任意源语言→地区语言)" ;;
    off|0|false|no) cfg_set PROMPT_TRANSLATE 0; ok "PROMPT_TRANSLATE=0 (关闭提示词翻译)" ;;
    status|"")
      echo "PROMPT_TRANSLATE=$(cfg_get PROMPT_TRANSLATE 1)"
      echo "TRANSLATE_ENGINE=$(cfg_get TRANSLATE_ENGINE auto)"
      echo "APP_LANG=$(cfg_get APP_LANG auto)"
      ;;
    *) die "fuckcc translate on|off|status" ;;
  esac
}
cmd_set_app_lang() {
  local v="${1:-auto}"
  case "$v" in
    auto|en|zh|zh-Hans|ja|ko|de) ;;
    *) die "fuckcc lang auto|en|zh|ja|ko|de" ;;
  esac
  [[ "$v" == "zh-Hans" ]] && v=zh
  cfg_set APP_LANG "$v"
  ok "APP_LANG=$v"
}


cmd_set_hide() {
  local v="${1:-}"
  case "$v" in
    1|base|normal) cfg_set HIDE_LEVEL 1; cfg_set DEEP 0; cfg_set PERSONA_PROMPT 0; ok "HIDE_LEVEL=1 (基础时区/locale)" ;;
    2|deep) cfg_set HIDE_LEVEL 2; cfg_set DEEP 1; cfg_set USE_HOOK 1; cfg_set SANITIZE 1; cfg_set PERSONA_PROMPT 1; ok "HIDE_LEVEL=2 (深藏: env清理+人设，不劫持路由)" ;;
    3|max|deeper) cfg_set HIDE_LEVEL 3; cfg_set DEEP 1; cfg_set USE_HOOK 1; cfg_set SANITIZE 1; cfg_set PERSONA_PROMPT 1; cfg_set DISABLE_TELEMETRY 1; ok "HIDE_LEVEL=3 (最深: +终端指纹清理，不劫持路由)" ;;
    status|"")
      echo "HIDE_LEVEL=$(cfg_get HIDE_LEVEL 2)"
      echo "DEEP=$(cfg_get DEEP 1)"
      echo "PERSONA_PROMPT=$(cfg_get PERSONA_PROMPT 1)"
      echo "USE_PROXY=$(cfg_get USE_PROXY 0)"
      echo "USE_HOOK=$(cfg_get USE_HOOK 1)"
      ;;
    *) die "fuckcc hide 1|2|3|status   (1基础 2深藏 3最深；域名反代请单独 fuckcc proxy-start)" ;;
  esac
}

usage() {
  cat <<EOF
${C_BLD}fuckcc${C_RST} v$FUCKCC_VERSION — Claude Code 进程级地区伪装 (macOS)

${C_BLD}日常:${C_RST}
  fuckcc regions              地区列表
  fuckcc use <id>             一键切换默认伪装
  fuckcc run [id] [-- args]   伪装启动 claude
  fuckcc probe [id]           environment fingerprint probe
  fuckcc status | doctor

${C_BLD}加深伪装:${C_RST}
  fuckcc deep                 打开 DEEP+HOOK+清理遥测
  fuckcc armor                一键拉满 deep+hook+proxy+shim
  fuckcc proxy-start|stop|status  本地反代藏中转域名
  fuckcc build-hook           dyld hook (TZ/locale/hostname)
  fuckcc install / install-global  装死：所有 claude 命令自动伪装+翻译钩子
  fuckcc install-hooks         只装提示词翻译钩子
  fuckcc install-shim         只装 PATH shim
  fuckcc uninstall [--purge]  卸载环境（--purge 连 ~/.fuckcc 一起删）
  fuckcc install-menubar / menubar
  fuckcc ui                     打开图形控制台

${C_BLD}其它:${C_RST}
  fuckcc env [id]             打印 export
  fuckcc selftest [id]
  fuckcc uninstall-shim

${C_BLD}原则:${C_RST}
  • 只动 Claude 子进程 TZ/locale/hook，${C_GRN}不动系统${C_RST}
  • IP / 支付 / 账号风控管不了
  • 中转域名在黑名单里时，时区伪装救不了域名轴

示例:
  fuckcc deep && fuckcc install-shim
  fuckcc use us-west
  fuckcc probe
  fuckcc run
EOF
}

main() {
  ensure_home
  load_risky_hints
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    ""|-h|--help|help) usage ;;
    version|--version|-V) echo "fuckcc $FUCKCC_VERSION" ;;
    regions|ls|list) list_regions ;;
    use|switch|set) [[ $# -ge 1 ]] || die "fuckcc use <region>"; set_region "$1" ;;
    run|start|claude) run_claude "$@" ;;
    env) cmd_env "${1:-}" ;;
    probe|scan) cmd_probe "${1:-}" ;;
    status|st) cmd_status ;;
    doctor) cmd_doctor ;;
    selftest|test) cmd_selftest "${1:-}" ;;
    deep|enable-deep) cmd_enable_deep; cfg_set HIDE_LEVEL 2; cfg_set PERSONA_PROMPT 1 ;;
    hide) cmd_set_hide "${1:-status}" ;;
    armor|full|max) cmd_armor ;;
    proxy-start|proxy_start) cmd_proxy_start ;;
    proxy-stop|proxy_stop) cmd_proxy_stop ;;
    proxy-status|proxy) cmd_proxy_status ;;
    build-hook|hook) cmd_build_hook ;;
    install-shim) cmd_install_shim ;;
    install-hooks) cmd_install_hooks ;;
    install|install-global|setup) cmd_install_global ;;
    translate-setup|local-translate) python3 "$SCRIPT_DIR/lib/translate_setup.py" ;;
    translate-daemon-start) cmd_translate_daemon_start ;;
    translate-daemon-stop) cmd_translate_daemon_stop ;;
    uninstall-shim) cmd_uninstall_shim ;;
    uninstall|remove|purge) cmd_uninstall "${1:-}" ;;
    install-menubar) cmd_install_menubar ;;
    menubar|menu) cmd_menubar ;;
    ui|gui|panel) cmd_ui ;;
    mode) if [[ $# -ge 1 ]]; then cmd_set_mode "$1"; else cmd_show_mode; fi ;;
    translate) cmd_set_translate "${1:-status}" ;;
    lang|app-lang) cmd_set_app_lang "${1:-auto}" ;;
    set-mode) cmd_set_mode "${1:-}" ;;
    *)
      if [[ -f "$REGIONS_FILE" ]] && region_exists "$cmd" 2>/dev/null; then
        set_region "$cmd"
      else
        die "未知命令: $cmd (fuckcc help)"
      fi
      ;;
  esac
}

main "$@"
