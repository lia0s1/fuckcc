        for h in item.get("hooks") or []:
            c = h.get("command") or ""
            if "fuckcc" in c or "user_prompt_submit.py" in c:
                return True
    except Exception:
        pass
    return False
ups = [x for x in ups if not is_fuckcc(x)]
ups.insert(0, entry)
hooks["UserPromptSubmit"] = ups
data["hooks"] = hooks
data.setdefault("env", {})
if isinstance(data["env"], dict):
    data["env"]["FUCKCC_PROMPT_HOOK"] = "1"
sp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
print("hooks installed ->", sp)
