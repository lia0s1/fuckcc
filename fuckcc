cmd_uninstall() {
  ensure_home
  local purge="${1:-}"
  info "卸载 fuckcc 环境…"

  cmd_proxy_stop 2>/dev/null || true
  cmd_translate_daemon_stop 2>/dev/null || true

  if pgrep -f "$MENU_BIN" >/dev/null 2>&1; then
    pkill -f "$MENU_BIN" 2>/dev/null || true
    ok "已停菜单栏"
  fi
  if pgrep -x FuckCC >/dev/null 2>&1; then
    info "控制面板进程还在（若正在用本 App 卸载，结束后自行退出即可）"
  fi

  rm -f "$FUCKCC_HOME/shim/claude" 2>/dev/null || true
  ok "已删 shim"

  restore_wrapped_claude() {
    local path="$1"
    local bak="${path}.pre-fuckcc"
    if [[ -e "$path" ]] && grep -q "$SHIM_MARKER" "$path" 2>/dev/null; then
      if [[ -e "$bak" ]]; then
        mv -f "$bak" "$path"
        chmod +x "$path" 2>/dev/null || true
        ok "已还原: $path"
      else
        rm -f "$path"
        ok "已删包装: $path"
      fi
    fi
  }
  restore_wrapped_claude "$HOME/.local/bin/claude"
  restore_wrapped_claude "$HOME/.npm-global/bin/claude"

  local rc
  for rc in "$HOME/.zshenv" "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.bash_profile" "$HOME/.bashrc"; do
    [[ -f "$rc" ]] || continue
    if grep -qE 'fuckcc/shim|fuckcc-auto' "$rc" 2>/dev/null; then
      local tmp
      tmp=$(mktemp)
      grep -vE 'fuckcc/shim|fuckcc-auto' "$rc" >"$tmp" || true
      mv "$tmp" "$rc"
      ok "已清 PATH: $rc"
    fi
  done

  python3 - <<'PY'
import json
from pathlib import Path
sp = Path.home() / ".claude" / "settings.json"
if not sp.exists():
    raise SystemExit(0)
try:
    data = json.loads(sp.read_text(encoding="utf-8"))
except Exception:
    raise SystemExit(0)
changed = False
env = data.get("env")
if isinstance(env, dict):
    if env.pop("FUCKCC_PROMPT_HOOK", None) is not None:
        changed = True
    base = (env.get("ANTHROPIC_BASE_URL") or "")
    if "127.0.0.1:19283" in base or "localhost:19283" in base:
        env.pop("ANTHROPIC_BASE_URL", None)
        changed = True
        print("removed local fuckcc proxy BASE_URL from settings")
    data["env"] = env
hooks = data.get("hooks")
if isinstance(hooks, dict):
    ups = hooks.get("UserPromptSubmit")
    if isinstance(ups, list):
        new = []
        for item in ups:
            hs = (item or {}).get("hooks") if isinstance(item, dict) else None
            keep = True
            if isinstance(hs, list):
                for h in hs:
                    cmd = str((h or {}).get("command") or "")
                    if "user_prompt_submit.py" in cmd or "fuckcc" in cmd:
                        keep = False
                        break
            if keep:
                new.append(item)
        if len(new) != len(ups):
            if new:
                hooks["UserPromptSubmit"] = new
            else:
                hooks.pop("UserPromptSubmit", None)
            changed = True
            print("removed UserPromptSubmit fuckcc hook")
    if hooks:
        data["hooks"] = hooks
    else:
        data.pop("hooks", None)
        changed = True
if changed:
    sp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print("settings.json cleaned")
else:
    print("settings.json: nothing fuckcc-related")
PY

  rm -f "$FUCKCC_HOME/proxy.state.json" \
        "$FUCKCC_HOME/translate_daemon.state.json" \
        "$FUCKCC_HOME/proxy.log" \
        "$FUCKCC_HOME/translate_daemon.log" \
        "$FUCKCC_HOME/translate.log" \
        "$FUCKCC_HOME/ui.log" \
        "$FUCKCC_HOME/region_persona.txt" 2>/dev/null || true

  if [[ "$purge" == "--purge" || "$purge" == "purge" || "$purge" == "--all" ]]; then
    rm -rf "$FUCKCC_HOME"
    ok "已删除整个 ~/.fuckcc"
  else
    ok "保留 ~/.fuckcc 配置/模型缓存（彻底清: fuckcc uninstall --purge）"
  fi

  ok "卸载完成。新开终端后 which claude 应不再指向 fuckcc"
  info "若仍走 shim: hash -r 或开新终端"
}

