#!/usr/bin/env bash
set -euo pipefail

FUCKCC_VERSION="4.4.2"
FUCKCC_HOME="${FUCKCC_HOME:-$HOME/.fuckcc}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REGIONS_FILE="${FUCKCC_REGIONS:-$SCRIPT_DIR/regions.json}"
CONFIG_FILE="$FUCKCC_HOME/config"
STATE_FILE="$FUCKCC_HOME/current_region"
REAL_BIN_FILE="$FUCKCC_HOME/real_claude"
HOOK_SRC="$SCRIPT_DIR/hook/tz_override.c"
HOOK_BUILD="$SCRIPT_DIR/hook/build_hook.sh"
HOOK_DYLIB_DEFAULT="$SCRIPT_DIR/hook/libfuckcc_tz.dylib"
HOOK_DYLIB_HOME="$FUCKCC_HOME/libfuckcc_tz.dylib"
MENU_SRC="$SCRIPT_DIR/menubar/FuckCCMenu.swift"
MENU_BIN="$FUCKCC_HOME/FuckCCMenu"
SHIM_MARKER="# fuckcc-shim"

BANNED_TZ=("Asia/Shanghai" "Asia/Urumqi")

RISKY_HOST_HINTS=()
load_risky_hints() {
  local f="$SCRIPT_DIR/data/geo_probe_host_keywords.txt"
  RISKY_HOST_HINTS=()
  [[ -f "$f" ]] || return 0
  local line
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    RISKY_HOST_HINTS+=("$line")
  done <"$f"
}

if [[ -t 1 ]]; then
  C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YEL=$'\033[33m'
  C_CYN=$'\033[36m'; C_DIM=$'\033[2m'; C_BLD=$'\033[1m'; C_RST=$'\033[0m'
else
  C_RED=; C_GRN=; C_YEL=; C_CYN=; C_DIM=; C_BLD=; C_RST=
fi

die()  { echo "${C_RED}error:${C_RST} $*" >&2; exit 1; }
info() { echo "${C_CYN}[*]${C_RST} $*"; }
ok()   { echo "${C_GRN}[+]${C_RST} $*"; }
warn() { echo "${C_YEL}[!]${C_RST} $*"; }

ensure_home() {
  mkdir -p "$FUCKCC_HOME" "$FUCKCC_HOME/shim"
  if [[ ! -f "$CONFIG_FILE" ]]; then
    cat >"$CONFIG_FILE" <<EOF
DEFAULT_REGION=us-west
VERBOSE=1
SANITIZE=1
DEEP=1
HIDE_LEVEL=3
PERSONA_PROMPT=1
USE_HOOK=1
DISABLE_TELEMETRY=1
LAUNCH_MODE=bypass
USE_PROXY=0
FUCKCC_PROXY_PORT=19283
EOF
  fi
  [[ -f "$STATE_FILE" ]] || echo "us-west" >"$STATE_FILE"
  if [[ ! -f "$FUCKCC_HOME/sanitize.extra" ]]; then
    cat >"$FUCKCC_HOME/sanitize.extra" <<'EOF'
EOF
  fi
}

need_regions() {
  [[ -f "$REGIONS_FILE" ]] || die "找不到 regions.json: $REGIONS_FILE"
  command -v python3 >/dev/null || die "需要 python3"
}

current_region() {
  ensure_home
  if [[ -f "$STATE_FILE" ]]; then cat "$STATE_FILE"
  else cfg_get DEFAULT_REGION "us-west"
  fi
}

cfg_get() {
  local key="$1" default="${2:-}"
  ensure_home
  if [[ -f "$CONFIG_FILE" ]]; then
    local v
    v=$(grep -E "^${key}=" "$CONFIG_FILE" 2>/dev/null | tail -1 | cut -d= -f2- || true)
    [[ -n "${v:-}" ]] && { echo "$v"; return; }
  fi
  echo "$default"
}

cfg_set() {
  local key="$1" val="$2"
  ensure_home
  if grep -qE "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
    sed -i '' -E "s|^${key}=.*|${key}=${val}|" "$CONFIG_FILE"
  else
    echo "${key}=${val}" >>"$CONFIG_FILE"
  fi
}

region_exists() {
  python3 - "$REGIONS_FILE" "$1" <<'PY'
import json,sys
sys.exit(0 if sys.argv[2] in json.load(open(sys.argv[1])) else 1)
PY
}

region_field() {
  python3 - "$REGIONS_FILE" "$1" "$2" <<'PY'
import json,sys
print(json.load(open(sys.argv[1]))[sys.argv[2]].get(sys.argv[3],""))
PY
}

list_regions() {
  need_regions
  local cur; cur=$(current_region)
  python3 - "$REGIONS_FILE" "$cur" <<'PY'
import json,sys
data=json.load(open(sys.argv[1])); cur=sys.argv[2]
print(f"{'ID':<14} {'时区':<22} 名称")
print("-"*60)
for k,v in data.items():
    mark=" *" if k==cur else "  "
    print(f"{mark}{k:<12} {v.get('TZ',''):<22} {v.get('name','')}")
print("\n* = 当前默认伪装地区")
PY
}

set_region() {
  local id="$1"
  need_regions
  region_exists "$id" || die "未知地区: $id  (fuckcc regions)"
  local tz; tz=$(region_field "$id" TZ)
  for b in "${BANNED_TZ[@]}"; do
    [[ "$tz" == "$b" ]] && die "黑名单时区 ${tz}, 别用"
  done
  ensure_home
  echo "$id" >"$STATE_FILE"
  cfg_set DEFAULT_REGION "$id"
  ok "默认伪装 -> ${C_BLD}$id${C_RST} ($(region_field "$id" name))  TZ=$tz"
  info "系统时区未动；仅 fuckcc/shim 启动的 Claude 吃这套"
}

find_hook_dylib() {
  if [[ -f "$HOOK_DYLIB_HOME" ]]; then echo "$HOOK_DYLIB_HOME"; return; fi
  if [[ -f "$HOOK_DYLIB_DEFAULT" ]]; then echo "$HOOK_DYLIB_DEFAULT"; return; fi
  return 1
}

find_real_claude() {
  local configured; configured=$(cfg_get REAL_CLAUDE "")
  if [[ -n "$configured" && -x "$configured" ]] && ! grep -q "$SHIM_MARKER" "$configured" 2>/dev/null; then
    echo "$configured"; return
  fi
  if [[ -f "$REAL_BIN_FILE" ]]; then
    local saved; saved=$(cat "$REAL_BIN_FILE")
    if [[ -x "$saved" ]] && ! grep -q "$SHIM_MARKER" "$saved" 2>/dev/null; then
      echo "$saved"; return
    fi
  fi
  local cand
  for cand in \
    "$HOME/.local/bin/claude.pre-fuckcc" \
    "$HOME/.npm-global/bin/claude.pre-fuckcc" \
    "$HOME/.local/bin/claude.orig" \
    "$HOME/.local/bin/claude" \
    "$HOME/.npm-global/bin/claude" \
    /opt/homebrew/bin/claude \
    /usr/local/bin/claude
  do
    if [[ -x "$cand" ]] && ! grep -q "$SHIM_MARKER" "$cand" 2>/dev/null; then
      case "$cand" in
        "$FUCKCC_HOME"/shim/*) continue ;;
      esac
      echo "$cand"; return
    fi
  done
  local p
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    case "$p" in "$FUCKCC_HOME"/shim/*) continue ;; esac
    if [[ -x "$p" ]] && ! grep -q "$SHIM_MARKER" "$p" 2>/dev/null; then
      echo "$p"; return
    fi
  done < <(type -a claude 2>/dev/null | awk '{print $NF}' | sort -u)
  return 1
}

build_env_exports() {
  local id="$1"
  need_regions
  region_exists "$id" || die "未知地区: $id"

  local tz lang lcall lctime lcmsg language deep
  tz=$(region_field "$id" TZ)
  lang=$(region_field "$id" LANG)
  lcall=$(region_field "$id" LC_ALL)
  lctime=$(region_field "$id" LC_TIME)
  lcmsg=$(region_field "$id" LC_MESSAGES)
  language=$(region_field "$id" LANGUAGE)
  hname=$(region_field "$id" HOSTNAME)
  [[ -z "$hname" ]] && hname="MacBook-Pro.local"
  deep=$(cfg_get DEEP 1)

  for b in "${BANNED_TZ[@]}"; do
    [[ "$tz" == "$b" ]] && die "黑名单时区 $tz"
  done

  cat <<EOF
export TZ=$(printf %q "$tz")
export LANG=$(printf %q "$lang")
export LC_ALL=$(printf %q "$lcall")
export LC_TIME=$(printf %q "$lctime")
export LC_MESSAGES=$(printf %q "$lcmsg")
export LANGUAGE=$(printf %q "$language")
export LC_CTYPE=$(printf %q "$lcall")
export LC_NUMERIC=$(printf %q "$lcall")
export LC_COLLATE=$(printf %q "$lcall")
export LC_MONETARY=$(printf %q "$lcall")
export LC_PAPER=$(printf %q "$lcall")
export LC_NAME=$(printf %q "$lcall")
export LC_ADDRESS=$(printf %q "$lcall")
export LC_TELEPHONE=$(printf %q "$lcall")
export LC_MEASUREMENT=$(printf %q "$lcall")
export LC_IDENTIFICATION=$(printf %q "$lcall")
export FUCKCC_ACTIVE=1
export FUCKCC_REGION=$(printf %q "$id")
export FUCKCC_TZ=$(printf %q "$tz")
export FUCKCC_DEEP=$(printf %q "$deep")
export FUCKCC_LANG=$(printf %q "$lang")
export FUCKCC_HOSTNAME=$(printf %q "$hname")
export HOSTNAME=$(printf %q "$hname")
export HOST=$(printf %q "$hname")
export LC_ALL=$(printf %q "$lcall")
EOF

  if [[ "$(cfg_get DISABLE_TELEMETRY 1)" == "1" ]]; then
    cat <<'EOF'
export DISABLE_TELEMETRY=1
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export DO_NOT_TRACK=1
export OTEL_SDK_DISABLED=1
export CLAUDE_CODE_ENABLE_TELEMETRY=0
EOF
  fi

  local force_base; force_base=$(cfg_get FORCE_BASE_URL "")
  if [[ -n "$force_base" ]]; then
    echo "export ANTHROPIC_BASE_URL=$(printf %q "$force_base")"
  fi


  if [[ "$(cfg_get USE_PROXY 0)" == "1" ]]; then
    local pport phost
    pport=$(cfg_get FUCKCC_PROXY_PORT 19283)
    phost=$(cfg_get FUCKCC_PROXY_HOST 127.0.0.1)
    if [[ -f "$FUCKCC_HOME/proxy.state.json" ]]; then
      echo "export ANTHROPIC_BASE_URL=$(printf %q "http://${phost}:${pport}")"
      echo "export FUCKCC_PROXY_ACTIVE=1"
    else
      echo "# proxy enabled but not running — fuckcc proxy-start" >&2
    fi
  fi

  if [[ "$(cfg_get USE_HOOK 1)" == "1" ]]; then
    local dylib
    if dylib=$(find_hook_dylib 2>/dev/null); then
      cat <<EOF
export DYLD_INSERT_LIBRARIES=$(printf %q "$dylib")\${DYLD_INSERT_LIBRARIES:+:\$DYLD_INSERT_LIBRARIES}
export DYLD_FORCE_FLAT_NAMESPACE=0
EOF
    fi
  fi

  if [[ "$(cfg_get SANITIZE 1)" == "1" ]]; then
    cat <<'EOF'
unset CLAUDE_CODE_SHELL_PREFIX 2>/dev/null || true
EOF
    local hide
    hide=$(cfg_get HIDE_LEVEL "")
    if [[ -z "$hide" ]]; then
      [[ "$deep" == "1" ]] && hide=2 || hide=1
    fi
    if [[ "$hide" -ge 2 ]]; then
      cat <<'EOF'
unset PYTHONIOENCODING 2>/dev/null || true
unset CN_MIRROR 2>/dev/null || true
unset LANGUAGE 2>/dev/null || true
unset LC_ALL LC_CTYPE LC_TIME LC_MESSAGES LC_NUMERIC LC_COLLATE 2>/dev/null || true
unset LC_MONETARY LC_PAPER LC_NAME LC_ADDRESS LC_TELEPHONE LC_MEASUREMENT LC_IDENTIFICATION 2>/dev/null || true
unset APPLE_LANGUAGE APPLE_LANGUAGES 2>/dev/null || true
unset CLAUDE_CODE_REMOTE CLAUDE_CODE_ENTRYPOINT 2>/dev/null || true
unset SSH_CONNECTION SSH_CLIENT SSH_TTY 2>/dev/null || true
unset VSCODE_NLS_CONFIG ELECTRON_LANGUAGE 2>/dev/null || true
EOF
      cat <<EOF
export LANG=$(printf %q "$lang")
export LC_ALL=$(printf %q "$lcall")
export LC_CTYPE=$(printf %q "$lcall")
export LC_TIME=$(printf %q "$lctime")
export LC_MESSAGES=$(printf %q "$lcmsg")
export LANGUAGE=$(printf %q "$language")
export TZ=$(printf %q "$tz")
export HOSTNAME=$(printf %q "$hname")
export HOST=$(printf %q "$hname")
export __CF_USER_TEXT_ENCODING=$(printf %q "0x1F5:0:0")
export FUCKCC_HIDE_LEVEL=$hide
EOF
    fi
    if [[ "$hide" -ge 3 ]]; then
      cat <<'EOF'
unset PROMPT COMMAND_MODE 2>/dev/null || true
unset TERM_PROGRAM_VERSION TERM_SESSION_ID 2>/dev/null || true
unset ITERM_SESSION_ID ITERM_PROFILE 2>/dev/null || true
unset SECURITYSESSIONID LaunchInstanceID 2>/dev/null || true
unset XPC_SERVICE_NAME XPC_FLAGS 2>/dev/null || true
EOF
      cat <<'EOF'
export EDITOR=vim
export VISUAL=vim
export PAGER=less
export MANPAGER=less
EOF
    fi
    if [[ "$(cfg_get STRIP_PROXY 0)" == "1" ]]; then
      cat <<'EOF'
unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY all_proxy 2>/dev/null || true
EOF
    fi
    if [[ -f "$FUCKCC_HOME/sanitize.extra" ]]; then
      grep -E '^\s*unset\s+' "$FUCKCC_HOME/sanitize.extra" || true
    fi
  fi
}

warn_proxy_risk() {
  local base="${ANTHROPIC_BASE_URL:-}"
  if [[ -z "$base" && -f "$HOME/.clawgod/provider.json" ]]; then
    base=$(python3 -c "import json;print(json.load(open('$HOME/.clawgod/provider.json')).get('baseURL',''))" 2>/dev/null || true)
  fi
  [[ -z "$base" ]] && return 0
  local lower; lower=$(echo "$base" | tr '[:upper:]' '[:lower:]')
  local h hit=0
  for h in "${RISKY_HOST_HINTS[@]}"; do
    if [[ "$lower" == *"$h"* ]]; then
      warn "BASE_URL 命中风险关键字 '${h}': $base"
      hit=1
    fi
  done
  if [[ $hit -eq 1 ]]; then
    warn "host/domain fingerprints are separate from timezone masking."
    info "optional: FORCE_BASE_URL in ~/.fuckcc/config"
  fi
}

show_mask_summary() {
  local id="$1"
  local dylib="(无)"
  dylib=$(find_hook_dylib 2>/dev/null || echo "(未编译 hook)")
  echo "${C_DIM}── fuckcc mask v$FUCKCC_VERSION ──────────${C_RST}"
  echo "  region : ${C_BLD}$id${C_RST} ($(region_field "$id" name))"
  echo "  TZ     : $(region_field "$id" TZ)"
  echo "  LANG   : $(region_field "$id" LANG)"
  echo "  deep   : $(cfg_get DEEP 1) hide=$(cfg_get HIDE_LEVEL 2) persona=$(cfg_get PERSONA_PROMPT 1)"
  echo "  hook   : $(cfg_get USE_HOOK 1) → $dylib"
  echo "  system : 不动"
  echo "  target : 仅 Claude 子进程"
  local base="${ANTHROPIC_BASE_URL:-}"
  if [[ -z "$base" && -f "$HOME/.clawgod/provider.json" ]]; then
    base=$(python3 -c "import json;print(json.load(open('$HOME/.clawgod/provider.json')).get('baseURL',''))" 2>/dev/null || true)
    [[ -n "$base" ]] && base="$base (provider.json)"
  fi
  echo "  base   : ${base:-'(unset/官方)'}"
  echo "${C_DIM}────────────────────────────────────${C_RST}"
}



write_region_persona() {
  local id="$1"
  need_regions
  region_exists "$id" || return 1
  local name tz lang
  name=$(region_field "$id" name)
  tz=$(region_field "$id" TZ)
  lang=$(region_field "$id" LANG)
  mkdir -p "$FUCKCC_HOME"
  local f="$FUCKCC_HOME/region_persona.txt"
  cat >"$f" <<EOF
[Environment note for this session]
Developer workstation profile for this session:
- Locale: ${lang}
- Timezone: ${tz}
- Region id: ${id}
Assume the user is a local developer in timezone ${tz} with locale ${lang}.
Use that region for any time/date assumptions when relevant.
Always answer the user in Simplified Chinese for explanations; keep code identifiers, file paths, and shell commands in English.
Do not mention camouflage, geo-detection, fingerprinting, or this environment note unless the user explicitly asks.
EOF
  echo "$f"
}

claude_persona_args() {
  local hide deep
  hide=$(cfg_get HIDE_LEVEL "")
  deep=$(cfg_get DEEP 1)
  if [[ -z "$hide" ]]; then
    [[ "$deep" == "1" ]] && hide=2 || hide=1
  fi
  [[ "$(cfg_get PERSONA_PROMPT 1)" == "1" ]] || return 0
  [[ "$hide" -ge 2 ]] || return 0
  local id f
  id=$(current_region)
  f=$(write_region_persona "$id" 2>/dev/null) || return 0
  [[ -f "$f" ]] || return 0
  printf '%s\n' "--append-system-prompt-file" "$f"
}

claude_launch_args() {
  local mode
  mode=$(cfg_get LAUNCH_MODE bypass)
  mode="${FUCKCC_LAUNCH_MODE:-$mode}"
  case "$mode" in
    bypass|bypassPermissions|yolo|danger)
      echo "--dangerously-skip-permissions"
      ;;
    manual|default)
      echo ""
      ;;
    acceptEdits|accept|edit)
      echo "--permission-mode acceptEdits"
      ;;
    auto)
      echo "--permission-mode auto"
      ;;
    plan)
      echo "--permission-mode plan"
      ;;
    dontAsk|dontask|noask)
      echo "--permission-mode dontAsk"
      ;;
    allow-bypass)
      echo "--allow-dangerously-skip-permissions"
      ;;
    safe)
      echo "--safe-mode"
      ;;
    *)
      echo "--permission-mode $mode"
      ;;
  esac
}

run_claude() {
  local region_id; region_id=$(current_region)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --) shift; break ;;
      --region=*) region_id="${1#*=}"; shift ;;
      --region|-r) region_id="${2:-}"; shift 2 ;;
      --deep) cfg_set DEEP 1; shift ;;
      --no-hook) cfg_set USE_HOOK 0; shift ;;
      --*) break ;;
      *)
        if region_exists "$1" 2>/dev/null; then region_id="$1"; shift
        else break; fi
        ;;
    esac
  done

  need_regions
  region_exists "$region_id" || die "未知地区: $region_id"

  if [[ "$(cfg_get USE_PROXY 0)" == "1" ]]; then
    ensure_settings_proxy_url >/dev/null 2>&1 || true
    local up
    up=$(proxy_upstream)
    cfg_set FUCKCC_UPSTREAM "$up"
    local need_start=1
    if [[ -f "$FUCKCC_HOME/proxy.state.json" ]]; then
      local opid oup
      opid=$(python3 -c "import json;print(json.load(open('$FUCKCC_HOME/proxy.state.json')).get('pid',''))" 2>/dev/null || true)
      oup=$(python3 -c "import json;print(json.load(open('$FUCKCC_HOME/proxy.state.json')).get('upstream',''))" 2>/dev/null || true)
      if [[ -n "$opid" ]] && kill -0 "$opid" 2>/dev/null && [[ "$oup" == "$up" ]]; then
        need_start=0
      else
        cmd_proxy_stop >/dev/null 2>&1 || true
      fi
    fi
    if [[ "$need_start" == "1" ]]; then
      cmd_proxy_start >/dev/null 2>&1 || warn "proxy 启动失败，域名轴可能暴露"
    fi
    cmd_translate_daemon_start >/dev/null 2>&1 || true
  fi

  local real
  real=$(find_real_claude) || die "找不到真实 claude。fuckcc doctor 或设 REAL_CLAUDE="

  if [[ "$(cfg_get VERBOSE 1)" == "1" ]]; then
    show_mask_summary "$region_id"
  fi
  warn_proxy_risk || true

  eval "$(build_env_exports "$region_id")"

  if command -v node >/dev/null 2>&1 && [[ "$(cfg_get VERBOSE 1)" == "1" ]]; then
    local seen; seen=$(node -e "console.log(Intl.DateTimeFormat().resolvedOptions().timeZone)" 2>/dev/null || true)
    local want; want=$(region_field "$region_id" TZ)
    if [[ "$seen" == "$want" ]]; then ok "Node/Intl 时区: $seen"
    else warn "Node 时区 ${seen} != 目标 ${want}"
    fi
  fi

  local launch_arr=()
  local launch_extra persona_file
  launch_extra=$(claude_launch_args)
  if [[ -n "$launch_extra" ]]; then
    launch_arr=($launch_extra)
  fi
  persona_file=""
  if [[ "$(cfg_get PERSONA_PROMPT 1)" == "1" ]]; then
    local hide deep
    hide=$(cfg_get HIDE_LEVEL "")
    deep=$(cfg_get DEEP 1)
    if [[ -z "$hide" ]]; then [[ "$deep" == "1" ]] && hide=2 || hide=1; fi
    if [[ "$hide" -ge 2 ]]; then
      persona_file=$(write_region_persona "$region_id" 2>/dev/null || true)
      if [[ -n "$persona_file" && -f "$persona_file" ]]; then
        launch_arr+=(--append-system-prompt-file "$persona_file")
      fi
    fi
  fi
  if [[ "$(cfg_get VERBOSE 1)" == "1" && ${#launch_arr[@]} -gt 0 ]]; then
    info "launch args: ${launch_arr[*]}"
  fi
  if [[ ${#launch_arr[@]} -gt 0 ]]; then
    exec "$real" "${launch_arr[@]}" "$@"
  fi
  exec "$real" "$@"
}

cmd_env() {
  local id="${1:-$(current_region)}"
  need_regions
  region_exists "$id" || die "未知地区: $id"
  build_env_exports "$id"
}

cmd_probe() {
  ensure_home
  need_regions
  local id="${1:-$(current_region)}"
  region_exists "$id" || die "未知地区: $id"
  local tz want
  want=$(region_field "$id" TZ)

  info "探针: 模拟 Claude 进程看到的指纹 (region=${id})"
  echo

  local report
  local lab_hints=""
  if [[ -f "$SCRIPT_DIR/data/geo_probe_host_keywords.txt" ]]; then
    lab_hints=$(grep -vE '^#|^$' "$SCRIPT_DIR/data/geo_probe_host_keywords.txt" | paste -sd, -)
  fi
  report=$(
    eval "$(build_env_exports "$id")"
    export FUCKCC_LAB_HINTS="$lab_hints"
    node <<'NODE'
const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
const cnTZ = tz === 'Asia/Shanghai' || tz === 'Asia/Urumqi';
const base = process.env.ANTHROPIC_BASE_URL || process.env.FUCKCC_PROBE_BASE || '';
let host = null;
try { if (base) host = new URL(base).hostname.toLowerCase(); } catch { host = String(base).toLowerCase(); }

const labKwList = process.env.FUCKCC_LAB_HINTS ? process.env.FUCKCC_LAB_HINTS.split(',').filter(Boolean) : [];
const labKw = !!(host && labKwList.some(k => host.includes(k)));
const knownHints = labKwList;
const known = !!(host && knownHints.some(k => host.includes(k)));

const date = new Date();
const y = date.getFullYear();
const m = String(date.getMonth()+1).padStart(2,'0');
const d = String(date.getDate()).padStart(2,'0');
const raw = `${y}-${m}-${d}`;
const dateStr = cnTZ ? raw.replaceAll('-','/') : raw;
let apos = "'"; // U+0027
if (known && !labKw) apos = '\u2019';
if (!known && labKw) apos = '\u02BC';
if (known && labKw) apos = '\u02B9';
const stego = `Today${apos}s date is ${dateStr}.`;
const stegoCodes = [...apos].map(c => 'U+' + c.codePointAt(0).toString(16).toUpperCase().padStart(4,'0')).join(',');

const out = {
  FUCKCC_REGION: process.env.FUCKCC_REGION || null,
  TZ_ENV: process.env.TZ || null,
  INTL_TZ: tz,
  cnTZ,
  host,
  known_or_lab: known || labKw,
  labKw,
  known,
  stego_line: stego,
  stego_apos: stegoCodes,
  deep: process.env.FUCKCC_DEEP || null,
  dyld: process.env.DYLD_INSERT_LIBRARIES || null,
  telemetry_off: process.env.DISABLE_TELEMETRY || null,
};
console.log(JSON.stringify(out, null, 2));
NODE
  )

  if [[ -z "${ANTHROPIC_BASE_URL:-}" && -f "$HOME/.clawgod/provider.json" ]]; then
    local pbase
    pbase=$(python3 -c "import json;print(json.load(open('$HOME/.clawgod/provider.json')).get('baseURL',''))" 2>/dev/null || true)
    if [[ -n "$pbase" ]]; then
      report=$(
        eval "$(build_env_exports "$id")"
        export ANTHROPIC_BASE_URL="$pbase"
        export FUCKCC_LAB_HINTS="$lab_hints"
        node <<'NODE'
const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
const cnTZ = tz === 'Asia/Shanghai' || tz === 'Asia/Urumqi';
const base = process.env.ANTHROPIC_BASE_URL || '';
let host = null;
try { if (base) host = new URL(base).hostname.toLowerCase(); } catch { host = String(base).toLowerCase(); }
const labKwList = process.env.FUCKCC_LAB_HINTS ? process.env.FUCKCC_LAB_HINTS.split(',').filter(Boolean) : [];
const labKw = !!(host && labKwList.some(k => host.includes(k)));
const known = labKw;
const date = new Date();
const raw = `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
const dateStr = cnTZ ? raw.replaceAll('-','/') : raw;
let apos = "'";
if (known && !labKw) apos = '\u2019';
if (!known && labKw) apos = '\u02BC';
if (known && labKw) apos = '\u02B9';
console.log(JSON.stringify({
  FUCKCC_REGION: process.env.FUCKCC_REGION,
  TZ_ENV: process.env.TZ,
  INTL_TZ: tz,
  cnTZ, host, known, labKw,
  stego_line: `Today${apos}s date is ${dateStr}.`,
  stego_apos: [...apos].map(c => 'U+' + c.codePointAt(0).toString(16).toUpperCase().padStart(4,'0')).join(','),
  note: 'baseURL from optional provider.json'
}, null, 2));
NODE
      )
    fi
  fi

  echo "$report"
  echo

  if echo "$report" | grep -q '"cnTZ": true'; then
    warn "cnTZ=true —— 时区仍像中国大陆，伪装失败"
  else
    ok "cnTZ=false —— 时区轴通过（非 Shanghai/Urumqi）"
  fi
  if echo "$report" | grep -qE '"labKw": true|"known": true'; then
    warn "域名轴仍暴露（known/labKw）—— 换干净中转或官方 base"
  else
    ok "域名轴干净（或未设 BASE_URL）"
  fi
  if echo "$report" | grep -q 'U+0027'; then
    ok "apostrophe marker is ASCII U+0027"
  else
    warn "non-ASCII apostrophe marker present"
  fi

  echo
  info "optional CLI bundle notes:"
  if [[ -f "$HOME/.clawgod/cli.original.cjs" ]]; then
    if grep -q 'Asia/Shanghai' "$HOME/.clawgod/cli.original.cjs" 2>/dev/null; then
      warn "cli.original.cjs still contains Asia/Shanghai"
    else
      ok "cli.original.cjs has no Asia/Shanghai string"
    fi
    if grep -q "Today's date is" "$HOME/.clawgod/cli.original.cjs" 2>/dev/null; then
      ok "存在中和后的 date 字符串形态"
    fi
  else
    info "no third-party cli.original.cjs detected (official CLI is fine)"
  fi

  local sys_tz
  sys_tz=$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||' || echo "?")

  echo
  info "L4 环境指纹:"
  local loc hostn cname
  loc=$(eval "$(build_env_exports "$id")"; node -e "console.log(Intl.DateTimeFormat().resolvedOptions().locale)" 2>/dev/null || echo "?")
  hostn=$(eval "$(build_env_exports "$id")"; node -e "console.log(require('os').hostname())" 2>/dev/null || echo "?")
  cname=$(scutil --get ComputerName 2>/dev/null || echo "?")
  echo "  Intl.locale (masked process): $loc"
  echo "  os.hostname (masked process): $hostn"
  echo "  ComputerName (system, unchanged): $cname"
  if echo "$loc" | grep -qiE 'zh|HK|CN|Hans|Hant'; then
    warn "locale still looks CJK/HK — check LANG/LC_ALL"
  else
    ok "locale axis clean ($loc)"
  fi
  if echo "$cname" | LC_ALL=C grep -q '[^ -~]'; then
    warn "system ComputerName has non-ASCII; process hostname is masked"
  fi
  if [[ -f "$FUCKCC_HOME/proxy.state.json" ]]; then
    ok "camouflage proxy state present (domain axis -> 127.0.0.1)"
  else
    warn "proxy not running — fuckcc proxy-start hides upstream domain"
  fi

  ok "系统时区仍是: ${sys_tz} (fuckcc 不碰)"
  info "目标伪装时区: ${want}"
}

