write_shim() {
  ensure_home
  local shim_dir="$FUCKCC_HOME/shim"
  mkdir -p "$shim_dir"
  local real
  real=$(find_real_claude) || die "找不到真实 claude"
  echo "$real" >"$REAL_BIN_FILE"
  cfg_set REAL_CLAUDE "$real"
  local self
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

  cat >"$shim_dir/claude" <<EOF
$SHIM_MARKER
set -euo pipefail
export FUCKCC_HOME="${FUCKCC_HOME}"
exec $(printf %q "$self") run -- "\$@"
EOF
  chmod +x "$shim_dir/claude"
  ok "shim: ${shim_dir}/claude -> ${real}"
}

install_path_line() {
  local line='export PATH="$HOME/.fuckcc/shim:$PATH"  # fuckcc'
  local rc
  for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.zprofile"; do
    if [[ -f "$rc" ]] && grep -qF 'fuckcc/shim' "$rc" 2>/dev/null; then
      info "PATH 已在 $rc"; return 0
    fi
  done
  if [[ -f "$HOME/.zshrc" ]]; then
    printf '\n%s\n' "$line" >>"$HOME/.zshrc"; ok "写入 ~/.zshrc"
  else
    printf '%s\n' "$line" >>"$HOME/.zshrc"; ok "创建 ~/.zshrc"
  fi
  warn "新开终端或: source ~/.zshrc"
}

