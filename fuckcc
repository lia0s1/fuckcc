ensure_settings_proxy_url() {
  local settings="$HOME/.claude/settings.json"
  [[ -f "$settings" ]] || return 0
  local port host up
  port=$(cfg_get FUCKCC_PROXY_PORT 19283)
  host=$(cfg_get FUCKCC_PROXY_HOST 127.0.0.1)
  up=$(proxy_upstream)
  python3 - "$settings" "$up" "http://${host}:${port}" "$FUCKCC_HOME/config" <<'PY'
import json,sys,re
from pathlib import Path
sp, upstream, local, cfgp = Path(sys.argv[1]), sys.argv[2], sys.argv[3], Path(sys.argv[4])
try:
    data=json.loads(sp.read_text(encoding='utf-8'))
except Exception:
    sys.exit(0)
env=data.get('env')
if not isinstance(env, dict):
    env={}
cur=(env.get('ANTHROPIC_BASE_URL') or '').strip()
if cur and '127.0.0.1' not in cur and 'localhost' not in cur:
    upstream=cur
text=cfgp.read_text(encoding='utf-8') if cfgp.exists() else ''
if re.search(r'^FUCKCC_UPSTREAM=', text, re.M):
    text=re.sub(r'^FUCKCC_UPSTREAM=.*', f'FUCKCC_UPSTREAM={upstream}', text, flags=re.M)
else:
    text=text.rstrip()+f'\nFUCKCC_UPSTREAM={upstream}\n'
cfgp.write_text(text, encoding='utf-8')
if env.get('ANTHROPIC_BASE_URL') != local:
    env['ANTHROPIC_BASE_URL']=local
    data['env']=env
    sp.write_text(json.dumps(data, ensure_ascii=False, indent=2)+'\n', encoding='utf-8')
    print(f'settings BASE_URL -> {local} (upstream={upstream})')
else:
    print(f'settings already local; upstream={upstream}')
PY
}

cmd_proxy_start() {
  ensure_home
  ensure_settings_proxy_url >/dev/null 2>&1 || true
  if [[ -f "$FUCKCC_HOME/proxy.state.json" ]]; then
    local oldpid
    oldpid=$(python3 -c "import json;print(json.load(open('$FUCKCC_HOME/proxy.state.json')).get('pid',''))" 2>/dev/null || true)
    if [[ -n "$oldpid" ]] && kill -0 "$oldpid" 2>/dev/null; then
      ok "proxy 已在跑 pid=$oldpid"
      cmd_proxy_status
      return 0
    fi
  fi
  local port host up script
  port=$(cfg_get FUCKCC_PROXY_PORT 19283)
  host=$(cfg_get FUCKCC_PROXY_HOST 127.0.0.1)
  ensure_settings_proxy_url >/dev/null 2>&1 || true
  up=$(proxy_upstream)
  script="$SCRIPT_DIR/proxy/camouflage_proxy.mjs"
  [[ -f "$script" ]] || die "缺少 proxy 脚本"
  cfg_set USE_PROXY 1
  cfg_set FUCKCC_UPSTREAM "$up"
  info "启动伪装代理 upstream=$up"
  FUCKCC_HOME="$FUCKCC_HOME" \
  FUCKCC_UPSTREAM="$up" \
  FUCKCC_PROXY_PORT="$port" \
  FUCKCC_PROXY_HOST="$host" \
  nohup node "$script" >>"$FUCKCC_HOME/proxy.log" 2>&1 &
  sleep 0.5
  if [[ -f "$FUCKCC_HOME/proxy.state.json" ]]; then
    ok "proxy 就绪: http://${host}:${port} -> $up"
    ok "Claude 将看到 BASE_URL=http://${host}:${port}"
  else
    warn "proxy 启动失败，看日志"
    tail -20 "$FUCKCC_HOME/proxy.log" 2>/dev/null || true
    return 1
  fi
}

cmd_proxy_stop() {
  ensure_home
  if [[ -f "$FUCKCC_HOME/proxy.state.json" ]]; then
    local oldpid
    oldpid=$(python3 -c "import json;print(json.load(open('$FUCKCC_HOME/proxy.state.json')).get('pid',''))" 2>/dev/null || true)
    if [[ -n "$oldpid" ]]; then
      kill "$oldpid" 2>/dev/null || true
      sleep 0.2
      kill -9 "$oldpid" 2>/dev/null || true
      ok "已停 proxy pid=$oldpid"
    fi
    rm -f "$FUCKCC_HOME/proxy.state.json"
  else
    info "proxy 未在跑"
  fi
}

cmd_proxy_status() {
